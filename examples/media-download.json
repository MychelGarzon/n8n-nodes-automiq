{
	"name": "AutomiQ: download media that customers send",
	"nodes": [
		{
			"parameters": {
				"events": ["messages"],
				"options": {}
			},
			"id": "0b6f3c1e-1a2b-4c3d-8e9f-000000000011",
			"name": "AutomiQ for WhatsApp Trigger",
			"type": "@automiq/n8n-nodes-automiq.automiqTrigger",
			"typeVersion": 1,
			"position": [0, 0]
		},
		{
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "strict",
						"version": 2
					},
					"conditions": [
						{
							"id": "0b6f3c1e-1a2b-4c3d-8e9f-0000000000a1",
							"leftValue": "={{ $json.media_id }}",
							"operator": {
								"type": "string",
								"operation": "notEmpty",
								"singleValue": true
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			},
			"id": "0b6f3c1e-1a2b-4c3d-8e9f-000000000012",
			"name": "Has media?",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2.2,
			"position": [220, 0]
		},
		{
			"parameters": {
				"resource": "message",
				"operation": "downloadMedia",
				"mediaNumberId": "={{ $('AutomiQ for WhatsApp Trigger').item.json.phone_number_id }}",
				"downloadMediaId": "={{ $('AutomiQ for WhatsApp Trigger').item.json.media_id }}",
				"binaryPropertyName": "data"
			},
			"id": "0b6f3c1e-1a2b-4c3d-8e9f-000000000013",
			"name": "Download Media",
			"type": "@automiq/n8n-nodes-automiq.automiq",
			"typeVersion": 1,
			"position": [440, -80]
		},
		{
			"parameters": {},
			"id": "0b6f3c1e-1a2b-4c3d-8e9f-000000000014",
			"name": "Save the file here",
			"type": "n8n-nodes-base.noOp",
			"typeVersion": 1,
			"position": [660, -80],
			"notes": "Replace this node with your storage: Google Drive, Dropbox, S3 or Nextcloud. The file is in the binary field named data. Media is limited to 4 MB."
		}
	],
	"connections": {
		"AutomiQ for WhatsApp Trigger": {
			"main": [[{ "node": "Has media?", "type": "main", "index": 0 }]]
		},
		"Has media?": {
			"main": [[{ "node": "Download Media", "type": "main", "index": 0 }], []]
		},
		"Download Media": {
			"main": [[{ "node": "Save the file here", "type": "main", "index": 0 }]]
		}
	},
	"settings": {}
}
